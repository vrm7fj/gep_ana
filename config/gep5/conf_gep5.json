    "runnums"              : [5951, 5952, 5953, 5954, 5956, 5959, 5961, 5965, 5968, 5969],
    "Nruns_to_ana"         : -1,
    "max_files_per_run"    : -1,

    "global_cut"           : "sqrt(pow((heep.dxECAL-0.01+0.025*earm.ecal.x)/0.0125,2)+pow((heep.dyECAL-(0.0019+0.00365*earm.ecal.x+0.0171*pow(earm.ecal.x,2)+0.01448*pow(earm.ecal.x,3)))/0.0157,2))<=3.5&&abs(heep.dt_ADC-0.5)<9&&abs(heep.dpp-0.0164)<0.04&&sbs.gemFPP.track.sclose<0.005&&abs(sbs.tr.vz+0.1)<0.175&&(sbs.gemFT.track.nhits>4||sbs.gemFT.track.ngoodhits>2)&&sqrt(pow((sbs.gemFPP.track.y+sbs.gemFPP.track.yp*6.7-sbs.hcal.y+0.0132)/0.0425,2)+pow((sbs.gemFPP.track.x+sbs.gemFPP.track.xp*6.7-sbs.hcal.x-0.192)/0.0497,2))<=3.5&&sbs.gemFPP.track.ngoodhits>1&&earm.ecal.nblk>2&&sbs.hcal.nblk>1",
    "extra_branches_for_global_cut" : [
        "heep.*", "earm.ecal.*", "sbs.tr.*", "Ndata.sbs.tr.*",
        "sbs.gemFT.track.*", "Ndata.sbs.gemFT.track.*",
        "sbs.gemFPP.track.*", "Ndata.sbs.gemFPP.track.*",
